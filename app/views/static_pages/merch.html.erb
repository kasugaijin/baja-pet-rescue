<section class="pt-5 pb-5" id="donate">
	<div class="container mb-md-5 mt-md-5">

		<!--page heading-->
		<div class="text-center mb-5">
			<h1 class="section-heading text-uppercase underline">
				Merchandise
			</h1>
		</div>
	
		<!--main section-->
			<div>
				<p class='bigger justify text-center'>
					You can now buy Baja Pet Rescue merch! Not only will you look <i>rockin'</i>, the proceeds will go a long way to help support our efforts.
				</p>

				<div class='d-flex flex-column align-items-center mt-4'>
					<h4 class='mb-4 mt-3'>Get your BPR merch!</h4>
					<%= link_to 'Go to store', 'https://baja-pet-rescue-shop.fourthwall.com/', class: 'custom-btn-pink text-center', target: '_blank' %>
				</div>
			</div>

			<div class="justify-content-center mt-4">
				<%= link_to image_tag('store.png', alt: 'Merch sample', class: 'img-fluid rounded'),
				            'https://baja-pet-rescue-shop.fourthwall.com/',
				            target: "_blank" %>
			</div>
		</div>
</section>